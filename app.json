{
  "expo": {
    "name": "TREX Wallet",
    "slug": "trex-wallet",
    "scheme": "trexwallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.trexwallet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#090812"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow TREX Wallet to use biometric authentication."
        }
      ]
    ]
  }
}