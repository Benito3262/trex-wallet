{
  "expo": {
    "name": "TREX Wallet",
    "slug": "trex-wallet",
    "scheme": "trexwallet",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.trexwallet.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#100804"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow TREX Wallet to use biometric authentication."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#100804",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#100804"
          }
        }
      ]
    ],
    "backgroundColor": "#100804"
  }
}
